{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolmera-com",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-05",
  "vars": {
    "GSC_SITE_URL": "sc-domain:toolmera.com"
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}