{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toolmera-com",
  "main": "src/workerWithTasks.ts",
  "compatibility_date": "2026-09-05",
  "keep_vars": true,
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_EMAIL",
      "GOOGLE_PRIVATE_KEY"
    ]
  },
  "vars": {
    "GSC_SITE_URL": "sc-domain:toolmera.com",
    "GA4_PROPERTY_ID": "552958073"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SEO_TASKS",
        "class_name": "SeoTaskStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "seo-task-store-v1",
      "new_sqlite_classes": [
        "SeoTaskStore"
      ]
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
